<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HASS.Agent.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HASS.Agent.Client.Views"
        xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HASS.Agent.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="HASS.Agent.Client">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ui:NavigationView x:Name="nvSample" PaneDisplayMode="Left" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Menu Item1" Tag="SamplePage1" IconSource="Play"/>
            <ui:NavigationViewItem Content="Menu Item2" Tag="SamplePage2" IconSource="Save" />
            <ui:NavigationViewItem Content="Menu Item3" Tag="SamplePage3" IconSource="Refresh" />
            <ui:NavigationViewItem Content="Menu Item4" Tag="SamplePage4" IconSource="Download" />
        </ui:NavigationView.MenuItems>
        
        <ContentControl Content="{Binding SelectedPage, Mode=TwoWay}"></ContentControl>
        
    </ui:NavigationView>

</Window>
